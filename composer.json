{
    "name": "erdembircan/battery-surf-bench",
    "description": "WordPress plugin that benchmarks battery drain by simulating real-world web surfing.",
    "type": "wordpress-plugin",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Erdem Bircan"
        }
    ],
    "require": {
        "php": ">=8.1",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.11",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "ErdemBircan\\BatterySurfBench\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErdemBircan\\BatterySurfBench\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage"
    }
}
