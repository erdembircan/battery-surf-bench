<?xml version="1.0"?>
<ruleset name="Battery Surf Bench">
	<description>WordPress coding standards for Battery Surf Bench.</description>

	<file>.</file>

	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress">
		<!-- The project uses PSR-4 CamelCase file names, not class-*.php. -->
		<exclude name="WordPress.Files.FileName"/>
		<!--
			The project's PHPDoc convention (see CLAUDE.md) is descriptions only:
			types are declared in the signature, so @param/@return omit them.
			These sniffs require redundant types and so conflict with it.
		-->
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamType"/>
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
		<exclude name="Squiz.Commenting.FunctionComment.MissingReturnType"/>
		<!-- Typed properties declare their type in the signature; @var is redundant. -->
		<exclude name="Squiz.Commenting.VariableComment.MissingVar"/>
	</rule>

	<!-- Check PHP cross-version compatibility down to the project's minimum. -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.1-"/>

	<config name="minimum_wp_version" value="6.0"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="battery-surf-bench"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="battery_surf_bench"/>
				<element value="ErdemBircan\BatterySurfBench"/>
			</property>
		</properties>
	</rule>
</ruleset>
