<?xml version="1.0"?>
<ruleset name="Battery Surf Bench">
	<description>WordPress coding standards for Battery Surf Bench.</description>

	<!-- Scan only our own source. Pointing PHPCS at "." forced it to recurse
	     and stat the entire tree (vendor, wp-playground's WordPress core,
	     node_modules — thousands of files) just to discard them via the
	     excludes below, turning a sub-second lint into a ~30s one. Listing the
	     source roots skips that traversal entirely. -->
	<file>battery-surf-bench.php</file>
	<file>includes/</file>
	<file>src/</file>
	<file>tests/</file>

	<!-- Belt-and-suspenders: keep generated/third-party trees out even if a
	     source root above ever grows to include one. These are `type="relative"`
	     and anchored with `^` so they match against the path *below the
	     basepath* (the project root), not the full absolute path. A bare
	     `<exclude-pattern>` defaults to `type="absolute"` (PHPCS Ruleset.php),
	     which is matched anywhere in the absolute path — so `/.claude/` would
	     wrongly exclude the entire checkout whenever the project itself lives
	     under a `.claude/` directory, e.g. an agent worktree at
	     `.../<project>/.claude/worktrees/<branch>/`. Anchoring to the root keeps
	     each exclude meaning "the project's own vendor/.claude/etc.", never a
	     directory name that merely appears in the absolute path. -->
	<exclude-pattern type="relative">^vendor/</exclude-pattern>
	<exclude-pattern type="relative">^node_modules/</exclude-pattern>
	<exclude-pattern type="relative">^build/</exclude-pattern>
	<!-- WordPress core downloaded for the local Playground; not our source. -->
	<exclude-pattern type="relative">^wp-playground/</exclude-pattern>
	<!-- Agent worktrees, each a full copy of the project; not our source. -->
	<exclude-pattern type="relative">^\.claude/</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress">
		<!-- The project uses PSR-4 CamelCase file names, not class-*.php. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<!-- Check PHP cross-version compatibility down to the project's minimum. -->
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.1-"/>

	<config name="minimum_wp_version" value="7.0"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="battery-surf-bench"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="battery_surf_bench"/>
				<element value="ErdemBircan\BatterySurfBench"/>
			</property>
		</properties>
	</rule>

	<!--
	  Scoped exceptions for test-infrastructure findings with no in-code fix.
	  Each is narrowed to the exact rule and path so the sniff still guards the
	  rest of the codebase. These are deliberate and maintainer-approved, not
	  blanket silencing. Production code has no output-escaping exceptions:
	  composed view markup prints through wp_kses() with the plugin's
	  AllowedHtml list.
	-->

	<!-- Tests inject mocks by setting the WordPress globals the code under test
	     reads ($wp_filesystem, $wp_styles, $wp_scripts). This is test
	     infrastructure, not production code overriding core state. -->
	<rule ref="WordPress.WP.GlobalVariablesOverride.Prohibited">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- The test bootstrap shims WordPress core classes for the test process.
	     They must carry core's exact (unprefixed) names so type hints and
	     instanceof checks resolve, several share the one bootstrap file, and the
	     filesystem double's signature-required parameters go unused. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedClassFound">
		<exclude-pattern>*/tests/bootstrap.php</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneObjectStructurePerFile.MultipleFound">
		<exclude-pattern>*/tests/bootstrap.php</exclude-pattern>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.Found">
		<exclude-pattern>*/tests/bootstrap.php</exclude-pattern>
	</rule>
</ruleset>
