%% Admin front-end shared modules — contract chart.
%% The React-only modules shared between the plugin's two wp-admin screens
%% (`src/settings/`, `src/sessions/`) rather than owned by either one. Each
%% screen's own internal modules (BrowsePane, SelectedPane, DataViews fields,
%% etc.) are that screen's private implementation and are not charted here —
%% this chart exists because `ErrorBoundary`/`Notice` are the first pieces of
%% admin UI genuinely shared across both screens' React trees. Function
%% components are marked <<module>>; the rest are classes. Only the public
%% (exported) surface is shown.
classDiagram
    direction LR

    class Notice {
        <<module>>
        Renders one free-text message in the shared toast shape AND enter/
        leave motion (`%bsb-toast`, `src/styles/theme/_toast.scss` — also extended
        by the cockpit's front-end toast, `src/styles/cockpit/style.scss`). Each
        kind (error/info/success) carries its own colour + icon. Owns a
        small local phase state (entering/holding/leaving) keyed off
        `visible`: a caller flips it to `false` to request the exit
        animation and keeps this mounted until `onExited` fires.
        +Notice(kind, message, visible?, onDismiss?, onExited?, dismissLabel?) ReactElement
    }

    class ErrorBoundary {
        Catches a render-time crash in an admin screen's React tree.
        Renders its children until a descendant throws, then a fallback:
        an error Notice plus a Reload control.
        +getDerivedStateFromError(Error) State
        +componentDidCatch(Error, ErrorInfo) void
        +render() ReactNode
    }

    ErrorBoundary ..> Notice : renders (error kind) in its fallback

    %% --- Composition: both admin entry points wrap their mounted app root.
    class SettingsIndex {
        <<module>>
        createRoot(#bsb-settings-app).render(ErrorBoundary > SettingsApp)
    }

    class SessionsIndex {
        <<module>>
        createRoot(#bsb-sessions-app).render(ErrorBoundary > SessionsApp)
    }

    SettingsIndex ..> ErrorBoundary : wraps SettingsApp in
    SessionsIndex ..> ErrorBoundary : wraps SessionsApp in
