    %% Never replaces WordPress's own oEmbed handling -- real oEmbed still
    %% resolves every YouTube URL, network fetch and all. embed_oembed_html
    %% amends the src of a YouTube/youtube-nocookie iframe WordPress's own
    %% handling already produced (via WP_HTML_Tag_Processor), merging the
    %% control params VideoControl needs and stripping autoplay, for ANY
    %% iframe reaching WP_Embed::shortcode() -- a fresh fetch or a
    %% pre-existing cache hit. Registered by CourseRouter per served page,
    %% never globally. is_youtube_src/amend_control_params are public pure
    %% logic (no WP_HTML_Tag_Processor dependency), kept public specifically
    %% so they are unit-testable on their own.
    class YouTubeEmbed {
        +register() void
        +embed_oembed_html(string html) string
        +is_youtube_src(string src) bool
        +amend_control_params(string src) string
    }

