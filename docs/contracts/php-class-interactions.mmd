%% PHP class interactions — contract chart.
classDiagram
    direction LR

    class BatterySurfBench {
        +const PLUGIN_FILE
        +const VERSION
        +__construct(string plugin_file)
        +init() void
        +container() Container
    }

    class ContainerInterface {
        <<interface>>
        +get(string id) mixed
        +has(string id) bool
    }

    class Container {
        +set(string id, mixed value) void
        +get(string id) mixed
        +has(string id) bool
    }

    class NotFoundExceptionInterface {
        <<interface>>
    }

    class InvalidArgumentException {
        <<abstract>>
    }

    class NotFoundException

    class Manager {
        <<interface>>
        +register() void
    }

    class Menu {
        +const SLUG
        +const CAPABILITY
        +const STYLE_HANDLE
        +__construct(string icon_url)
        +register() void
        +add_page() void
        +enqueue_icon_style() void
        +render() void
    }

    BatterySurfBench --> Container : creates & owns (composition)
    BatterySurfBench --> Menu : creates & owns (composition)
    BatterySurfBench ..> Manager : registers
    Menu ..|> Manager : implements
    Container ..|> ContainerInterface : implements
    Container ..> NotFoundException : throws
    NotFoundException --|> InvalidArgumentException : extends
    NotFoundException ..|> NotFoundExceptionInterface : implements
