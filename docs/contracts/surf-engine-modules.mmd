%% Surf engine modules — contract chart.
%% The utility-AI engine that runs inside the course-page iframe (src/surfer/).
%% Every action the surfer can take is a Behavior that bids in an auction each
%% tick; SurfLoop draws a winner via the Arbiter and runs it through a Motor.
%% No behavior-selection branching exists — bids are pure multiplicative
%% functions of traits, affordances, appetite and noise. Function-only modules
%% are marked <<module>>; interfaces <<interface>>; the rest are classes. Only
%% the public (exported) surface is shown. Test doubles (FakeMotor, FakeClock)
%% are test infrastructure, not architecture, and are omitted.
classDiagram
    direction LR

    %% --- Boot: the classic script the course router enqueues on every course
    %% page. Boots the engine only when the traits URL param is present.
    class EngineBoot {
        <<module>>
        boot guard on the traits URL param; builds and starts SurfLoop once
        the document has loaded; posts 'bsb:pageDone' to the parent frame
        when the page's session ends; posts 'bsb:behaviorStart' with the
        winner's key each time one begins running
    }

    %% --- Orchestration: the tick loop and its inputs.
    %% onBehaviorRun (an optional SurfLoopDeps callback) is notified with each
    %% auction winner's key as it begins running, including MoveOn (before the
    %% loop halts and fires onPageDone) — the engine stays flavor-free, only
    %% posting every winner's key; the cockpit's string table decides what barks.
    class SurfLoop {
        +start() void
        +stop() void
    }

    class Arbiter {
        <<module>>
        +pickBehavior(Ballot[], Rng) Behavior|null
    }

    class Appetite {
        +valueFor(string) number
        +consume(string) void
        +recoverTick() void
    }

    %% --- The behavior contract every action implements.
    class Behavior {
        <<interface>>
        +key string
        +bid(BehaviorContext, appetite, boredom) number
        +run(Motor, BehaviorContext) Promise
    }

    class BehaviorContext {
        <<types>>
        traits, affordances, rng, clock, speed, elapsedMs
    }

    %% --- Sensing, motion and time seams the behaviors act through.
    class Affordances {
        <<module>>
        +senseAffordances(Document) Affordances
    }

    class Motor {
        <<interface>>
        +scrollBy(px, ms) Promise
        +pointerDrift(ms) Promise
        +selectSnippet() Promise
        +playVideo() Promise
        +lingerImage(ms) Promise
        +idle(ms) Promise
    }

    %% The only DOM writer in the engine.
    class DomMotor {
        +scrollBy(px, ms) Promise
        +pointerDrift(ms) Promise
        +selectSnippet() Promise
        +playVideo() Promise
        +lingerImage(ms) Promise
        +idle(ms) Promise
    }

    %% The visible cursor DomMotor drives — synthetic mousemove events alone
    %% render nothing, so pointerDrift and selectSnippet move this instead.
    class FakeCursor {
        +position Point
        +moveTo(Point) void
        +travelTo(Point, Rng, frames?) Promise
        +framesForDistance(distance) number$
    }

    class Clock {
        <<interface>>
        +wait(ms) Promise
        +now() number
    }

    class RealClock {
        +wait(ms) Promise
        +now() number
    }

    class Rng {
        <<module>>
        +mulberry32(seed) Rng
    }

    %% --- Shared bid arithmetic and the tempo metronome.
    class Bid {
        <<module>>
        +drive(stat) number
        +noise(Rng) number
        +lerp(min, max, t) number
        +clamp01(number) number
    }

    class Tempo {
        <<module>>
        +tickIntervalMs(tempo) number
        +flickPx(tempo) number
        +flickEaseMs(tempo) number
    }

    %% Shared easing curve — DomMotor's scroll and FakeCursor's travel both
    %% ease progress through this one function rather than each carrying
    %% their own copy of the same curve.
    class Ease {
        <<module>>
        +easeInOutQuad(t) number
    }

    %% --- Behaviors: one bidder per action, each governed by one primary stat.
    %% ScrollBurst: baseline mover, constant drive × scrollRemaining affordance.
    class ScrollBurst {
        +key string
        +bid(BehaviorContext, appetite, boredom) number
        +run(Motor, BehaviorContext) Promise
    }
    %% ReadPause: literacy, gated by textDensity.
    class ReadPause {
        +key string
        +bid(BehaviorContext, appetite, boredom) number
        +run(Motor, BehaviorContext) Promise
    }
    %% GlanceBack: literacy; affordance grows as scrollRemaining shrinks.
    class GlanceBack {
        +key string
        +bid(BehaviorContext, appetite, boredom) number
        +run(Motor, BehaviorContext) Promise
    }
    %% WatchVideo: allure, gated by hasVideo.
    class WatchVideo {
        +key string
        +bid(BehaviorContext, appetite, boredom) number
        +run(Motor, BehaviorContext) Promise
    }
    %% LingerImage: allure, gated by imageCount.
    class LingerImage {
        +key string
        +bid(BehaviorContext, appetite, boredom) number
        +run(Motor, BehaviorContext) Promise
    }
    %% FidgetWiggle: fidget, no page affordance needed.
    class FidgetWiggle {
        +key string
        +bid(BehaviorContext, appetite, boredom) number
        +run(Motor, BehaviorContext) Promise
    }
    %% MicroScroll: fidget, no page affordance needed.
    class MicroScroll {
        +key string
        +bid(BehaviorContext, appetite, boredom) number
        +run(Motor, BehaviorContext) Promise
    }
    %% SelectSnippet: fidget, gated by textDensity.
    class SelectSnippet {
        +key string
        +bid(BehaviorContext, appetite, boredom) number
        +run(Motor, BehaviorContext) Promise
    }
    %% MoveOn: bids boredom × leave-readiness, a dwell-floor affordance that
    %% ramps 0 to 1 over time on page; SurfLoop halts the page on this key.
    class MoveOn {
        +key string
        +bid(BehaviorContext, appetite, boredom) number
        +run() Promise
    }

    %% Boot's document-load gate.
    class PageLoad {
        <<module>>
        +whenDocumentLoaded(Window, callback) void
    }

    ScrollBurst ..|> Behavior
    ReadPause ..|> Behavior
    GlanceBack ..|> Behavior
    WatchVideo ..|> Behavior
    LingerImage ..|> Behavior
    FidgetWiggle ..|> Behavior
    MicroScroll ..|> Behavior
    SelectSnippet ..|> Behavior
    MoveOn ..|> Behavior
    DomMotor ..|> Motor
    RealClock ..|> Clock

    EngineBoot --> SurfLoop : builds deps & starts
    EngineBoot --> PageLoad : gates start on document load
    EngineBoot --> DomMotor : creates
    DomMotor --> FakeCursor : creates & owns (composition)
    EngineBoot --> RealClock : creates
    EngineBoot --> Rng : seeds the one PRNG instance
    EngineBoot --> Affordances : provides senseAffordances
    EngineBoot --> SurferStats : normalizeTraits
    EngineBoot --> RunConfig : normalizeSpeed
    EngineBoot ..> RunStore : postMessage 'bsb:pageDone'
    EngineBoot ..> BarkStore : postMessage 'bsb:behaviorStart' (every winner's key)

    SurfLoop --> Behavior : bids & runs each tick
    SurfLoop --> Arbiter : draws a winner
    SurfLoop --> Appetite : creates & owns (composition)
    SurfLoop --> Motor : passes to the winning behavior
    SurfLoop --> Clock : waits between ticks
    SurfLoop --> Rng : seeded randomness
    SurfLoop --> Tempo : tick interval from tempo
    SurfLoop ..> BehaviorContext : builds each tick
    SurfLoop --> MoveOn : recognizes its key to halt & fire onPageDone

    ReadPause --> Bid : drive & noise
    GlanceBack --> Bid : drive & noise
    WatchVideo --> Bid : drive & noise
    LingerImage --> Bid : drive & noise
    FidgetWiggle --> Bid : drive & noise
    MicroScroll --> Bid : drive & noise
    SelectSnippet --> Bid : drive & noise
    ScrollBurst --> Bid : noise
    ScrollBurst --> Tempo : flick px & ease
    Bid --> SurferStats : MAX

    DomMotor --> Ease : eases scroll & travel progress
    FakeCursor --> Ease : eases travel progress

    Behavior ..> BehaviorContext : reads
    Behavior ..> Motor : acts through

    %% --- Shared contracts with the cockpit (see cockpit-frontend-modules.mmd).
    class SurferStats {
        <<module>>
        shared trait vector contract — STATS, MAX
    }

    class RunConfig {
        <<module>>
        shared speed contract — normalizeSpeed
    }

    class RunStore {
        <<module>>
        cockpit-side receiver — currentSrc carries traits+speed onto the
        iframe URL; a page-done listener advances activeIndex
    }

    class BarkStore {
        <<module>>
        cockpit-side receiver — recognizes 'bsb:behaviorStart' while running
        and raises a bark for the winner's key (a key with no translated
        strings is silently ignored)
    }
