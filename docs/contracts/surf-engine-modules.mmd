%% Surf engine modules — contract chart.
%% The utility-AI engine that runs inside the course-page iframe (src/surfer/).
%% Every action the surfer can take is a Behavior that bids in an auction each
%% tick; SurfLoop draws a winner via the Arbiter and runs it through a Motor.
%% No behavior-selection branching exists — bids are pure multiplicative
%% functions of traits, affordances, appetite and noise. Function-only modules
%% are marked <<module>>; interfaces <<interface>>; the rest are classes. Only
%% the public (exported) surface is shown. Test doubles (FakeMotor, FakeClock)
%% are test infrastructure, not architecture, and are omitted.
%% Characters Mermaid would misread inside a label are written as entity codes,
%% which render as the character itself: #58; ':', #59; ';', #40; '(', #41; ')',
%% #123; '{', #125; '}'. See "Keeping Charts Parseable" in CLAUDE.md.
classDiagram
    direction LR

    %% --- Boot: the classic script the course router enqueues on every course
    %% page. Boots the engine only when the traits URL param is present. When
    %% the bsbSterile=1 param is ALSO present, builds and starts a SterileHelm
    %% instead of a SurfLoop — the auction never ticks; every other dep
    %% (motor, behaviors, traits, senseAffordances, speed, the shared
    %% onPageDone/onBehaviorRun callbacks) is identical either way.
    class EngineBoot {
        <<module>>
        boot guard on the traits URL param; builds and starts SurfLoop (or,
        when bsbSterile=1, a SterileHelm instead#41; once the document has
        loaded; posts 'bsb:pageDone' to the parent frame when the page's
        session ends; posts 'bsb:behaviorStart' with the winner's key and its
        announced wall-clock durationMs once, each time a behavior begins
        running (including MoveOn, with a fixed display duration); the
        sterile path additionally posts 'bsb:behaviorEnd' once a steered
        behavior's run() resolves, and 'bsb:pageAffordances' once, at
        readiness
    }

    %% --- Orchestration: the tick loop and its inputs.
    %% onBehaviorRun (an optional SurfLoopDeps callback) is notified once per
    %% winner with its key and wall-clock durationMs as it begins running —
    %% for MoveOn a fixed display duration (it has no dwell of its own,
    %% before the loop halts and fires onPageDone); for every other winner,
    %% whatever duration its own run() reports via the announce callback
    %% passed into it. A behavior that never calls announce (the mechanical
    %% scrollBurst/microScroll/fidgetWiggle) simply never notifies — the
    %% engine stays flavor-free, only posting a key+duration; the cockpit's
    %% string table decides what barks and its own timers own the pill's
    %% full-duration hold, so no re-notification/heartbeat exists.
    class SurfLoop {
        +start() void
        +stop() void
    }

    %% --- Sterile run: no auction, no tick loop, no boredom/appetite. Each
    %% behavior is instead fired on demand by a 'bsb:steerBehavior' command
    %% from the dev-tools panel, strictly sequential (a steer arriving while
    %% one is still running is ignored). A steered moveOn mirrors the loop's
    %% own natural end exactly — announces MOVE_ON_DISPLAY_MS, posts
    %% 'bsb:behaviorEnd', fires onPageDone immediately — never runs an actual
    %% behavior. Every other steered behavior runs through its own run(),
    %% wired to announce/onBehaviorRun the same way the loop wires it; once
    %% run() resolves, posts 'bsb:behaviorEnd'.
    class SterileHelm {
        +start() void
        +stop() void
    }

    class Arbiter {
        <<module>>
        +pickBehavior(Ballot[], Rng) Behavior|null
    }

    class Appetite {
        +valueFor(string) number
        +consume(string) void
        +recover(steps) void
    }

    %% --- The behavior contract every action implements.
    %% announce is called once from inside run(), at the moment the behavior
    %% knows its own wall-clock dwell, before awaiting — the cockpit's bark
    %% countdown matches that exact duration. Behaviors with no dwell to
    %% announce (the mechanical ones) simply never call it.
    class Behavior {
        <<interface>>
        +key string
        +bid(BehaviorContext, appetite, boredom) number
        +run(Motor, BehaviorContext, announce?) Promise
    }

    class BehaviorContext {
        <<types>>
        traits, affordances, rng, clock, speed, elapsedMs
    }

    class BehaviorAnnounce {
        <<types>>
        #40;durationMs#41; =&gt; void
    }

    %% --- Shared context-building: senses affordances fresh and derives
    %% elapsedMs from a clock and a reference start time. Used by BOTH
    %% SurfLoop's own tick loop and SterileHelm's steer handler, so the two
    %% engine paths can never sense the page differently.
    class PageSense {
        <<module>>
        +buildBehaviorContext(deps, startedAt) BehaviorContext
    }

    %% --- Sensing, motion and time seams the behaviors act through.
    class Affordances {
        <<module>>
        +senseAffordances(Document) Affordances
        +contentRoot(Document) Element
        +VIDEO_EMBED_SELECTOR
    }

    class Motor {
        <<interface>>
        +scrollBy(px, ms) Promise
        +pointerDrift(ms) Promise
        +selectSnippet() Promise
        +playVideo() Promise
        +stopVideo() Promise
        +lingerImage(ms) Promise
        +read(ms) Promise
        +idle(ms) Promise
    }

    %% The only DOM writer in the engine.
    class DomMotor {
        +scrollBy(px, ms) Promise
        +pointerDrift(ms) Promise
        +selectSnippet() Promise
        +playVideo() Promise
        +stopVideo() Promise
        +lingerImage(ms) Promise
        +read(ms) Promise
        +idle(ms) Promise
    }

    %% The visible cursor DomMotor drives — synthetic mousemove events alone
    %% render nothing, so pointerDrift and selectSnippet move this instead.
    %% Wears a glyph mode (arrow, caret while highlighting/read-tracing, hand
    %% while clicking a video player) and plays a press-and-ripple click; the
    %% glyphs themselves live in the course stylesheet.
    class FakeCursor {
        +position Point
        +mode CursorMode
        +moveTo(Point) void
        +travelTo(Point, Rng, frames?) Promise
        +setMode(CursorMode) void
        +click() Promise
        +framesForDistance(distance) number$
    }

    %% Starts, stops and replays whatever element playVideo attended -- a
    %% real <video> via its element API and native 'ended' event, or a
    %% YouTube/youtube-nocookie embed iframe via the IFrame API's raw
    %% postMessage command protocol (no external script load), subscribing
    %% to the player's own event messages -- and lets a caller subscribe to
    %% the moment it ends via onEnded, event-driven (no polling): the
    %% subscriber fires the instant the player transitions into 'ended', not
    %% on a repeated "still ended" message. Confirmed against a real embed.
    %% play() replays from the start when the player has ended and no-ops
    %% when already playing; stop() is a genuine full stop. Anything else
    %% (Vimeo, unparseable src) is a safe no-op whose onEnded never fires.
    class VideoControl {
        <<interface>>
        +play() Promise
        +stop() Promise
        +onEnded(callback) unsubscribe
        +dispose() void
        +createVideoControl(Element) VideoControl$
    }

    class Clock {
        <<interface>>
        +wait(ms) Promise
        +now() number
    }

    class RealClock {
        +wait(ms) Promise
        +now() number
    }

    class Rng {
        <<module>>
        +mulberry32(seed) Rng
    }

    %% --- Shared bid arithmetic and the tempo metronome.
    class Bid {
        <<module>>
        +drive(stat) number
        +noise(Rng) number
        +lerp(min, max, t) number
        +clamp01(number) number
    }

    class Tempo {
        <<module>>
        +tickIntervalMs(tempo) number
        +flickPx(tempo) number
        +flickEaseMs(tempo) number
    }

    %% Shared easing curve — DomMotor's scroll and FakeCursor's travel both
    %% ease progress through this one function rather than each carrying
    %% their own copy of the same curve.
    class Ease {
        <<module>>
        +easeInOutQuad(t) number
    }

    %% --- Behaviors: one bidder per action, each governed by one primary stat.
    %% ScrollBurst: baseline mover, constant drive × scrollRemaining affordance.
    class ScrollBurst {
        +key string
        +bid(BehaviorContext, appetite, boredom) number
        +run(Motor, BehaviorContext) Promise
    }
    %% ReadPause: literacy, gated by textDensity.
    class ReadPause {
        +key string
        +bid(BehaviorContext, appetite, boredom) number
        +run(Motor, BehaviorContext) Promise
    }
    %% GlanceBack: literacy; affordance grows as scrollRemaining shrinks.
    class GlanceBack {
        +key string
        +bid(BehaviorContext, appetite, boredom) number
        +run(Motor, BehaviorContext) Promise
    }
    %% WatchVideo: allure, gated by hasVideo.
    class WatchVideo {
        +key string
        +bid(BehaviorContext, appetite, boredom) number
        +run(Motor, BehaviorContext) Promise
    }
    %% LingerImage: allure, gated by imageCount.
    class LingerImage {
        +key string
        +bid(BehaviorContext, appetite, boredom) number
        +run(Motor, BehaviorContext) Promise
    }
    %% FidgetWiggle: fidget, no page affordance needed.
    class FidgetWiggle {
        +key string
        +bid(BehaviorContext, appetite, boredom) number
        +run(Motor, BehaviorContext) Promise
    }
    %% MicroScroll: fidget, no page affordance needed.
    class MicroScroll {
        +key string
        +bid(BehaviorContext, appetite, boredom) number
        +run(Motor, BehaviorContext) Promise
    }
    %% SelectSnippet: fidget, gated by textDensity.
    class SelectSnippet {
        +key string
        +bid(BehaviorContext, appetite, boredom) number
        +run(Motor, BehaviorContext) Promise
    }
    %% MoveOn: bids boredom × leave-readiness, a dwell-floor affordance that
    %% ramps 0 to 1 over time on page; SurfLoop halts the page on this key.
    class MoveOn {
        +key string
        +bid(BehaviorContext, appetite, boredom) number
        +run() Promise
    }

    %% Boot's document-load gate.
    class PageLoad {
        <<module>>
        +whenDocumentLoaded(Window, callback) void
    }

    ScrollBurst ..|> Behavior
    ReadPause ..|> Behavior
    GlanceBack ..|> Behavior
    WatchVideo ..|> Behavior
    LingerImage ..|> Behavior
    FidgetWiggle ..|> Behavior
    MicroScroll ..|> Behavior
    SelectSnippet ..|> Behavior
    MoveOn ..|> Behavior
    DomMotor ..|> Motor
    RealClock ..|> Clock

    EngineBoot --> SurfLoop : builds deps & starts (bsbSterile absent)
    EngineBoot --> SterileHelm : builds deps & starts (bsbSterile=1)
    EngineBoot --> PageLoad : gates start on document load
    EngineBoot --> DomMotor : creates
    DomMotor --> FakeCursor : creates & owns (composition)
    EngineBoot --> RealClock : creates
    EngineBoot --> Rng : seeds the one PRNG instance
    EngineBoot --> Affordances : provides senseAffordances
    DomMotor --> Affordances : shares contentRoot & VIDEO_EMBED_SELECTOR (lingerImage, playVideo, read, selectSnippet)
    DomMotor --> VideoControl : builds via createVideoControl, subscribes onEnded to auto-replay, keeps the active one (+ unsubscribe) for stopVideo
    EngineBoot --> SurferStats : normalizeTraits
    EngineBoot --> RunConfig : normalizeSpeed
    EngineBoot ..> RunStore : postMessage 'bsb#58;pageDone'
    EngineBoot ..> BarkStore : postMessage 'bsb#58;behaviorStart' ({key, durationMs})
    EngineBoot ..> SurfSteerStore : postMessage 'bsb#58;behaviorEnd' ({key}), 'bsb#58;pageAffordances' ({affordances}) — sterile path only

    SurfLoop --> Behavior : bids & runs each tick
    SurfLoop --> Arbiter : draws a winner
    SurfLoop --> Appetite : creates & owns (composition)
    SurfLoop --> Motor : passes to the winning behavior
    SurfLoop --> Clock : waits between ticks
    SurfLoop --> Rng : seeded randomness
    SurfLoop --> Tempo : tick interval from tempo
    SurfLoop --> PageSense : builds each tick's BehaviorContext
    SurfLoop --> MoveOn : recognizes its key to halt & fire onPageDone

    SterileHelm --> Behavior : runs the steered behavior once
    SterileHelm --> Motor : passes to the steered behavior
    SterileHelm --> PageSense : builds the steered behavior's BehaviorContext
    SterileHelm --> MoveOn : recognizes its key to mirror the loop's natural end
    SterileHelm ..> SurfSteerStore : listens for 'bsb#58;steerBehavior' ({key}) posted by the panel

    ReadPause --> Bid : drive & noise
    GlanceBack --> Bid : drive & noise
    WatchVideo --> Bid : drive & noise
    LingerImage --> Bid : drive & noise
    FidgetWiggle --> Bid : drive & noise
    MicroScroll --> Bid : drive & noise
    SelectSnippet --> Bid : drive & noise
    ScrollBurst --> Bid : noise
    ScrollBurst --> Tempo : flick px & ease
    Bid --> SurferStats : MAX

    DomMotor --> Ease : eases scroll & travel progress
    FakeCursor --> Ease : eases travel progress

    Behavior ..> BehaviorContext : reads
    Behavior ..> Motor : acts through
    Behavior ..> BehaviorAnnounce : calls once with its wall-clock dwell

    %% --- Shared contracts with the cockpit (see cockpit-frontend-modules.mmd).
    class SurferStats {
        <<module>>
        shared trait vector contract — STATS, MAX
    }

    class RunConfig {
        <<module>>
        shared speed contract — normalizeSpeed
    }

    class RunStore {
        <<module>>
        cockpit-side receiver — currentSrc carries traits+speed onto the
        iframe URL; a page-done listener advances activeIndex
    }

    class BarkStore {
        <<module>>
        cockpit-side receiver — recognizes 'bsb:behaviorStart' (key +
        durationMs#41; while running and raises a bark held for the announced
        wall-clock duration (a key with no translated strings is silently
        ignored#41;
    }

    class SurfSteerStore {
        <<module>>
        dev-tools panel store part — posts 'bsb:steerBehavior' (#123;key#125;) to the
        viewport iframe's contentWindow; recognizes 'bsb:behaviorEnd' and
        'bsb:pageAffordances' to drive the panel's chip gating/countdown
    }
