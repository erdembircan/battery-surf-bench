%% Cockpit front-end modules — contract chart.
%% The client side of the `bsb/cockpit` block: the Interactivity store and the
%% focused domains it delegates to. The store is built from focused domain
%% slices — each a <<module>> exporting a StorePart — that the view composes into
%% one store definition and registers under the `bsb/cockpit` namespace. The
%% slices share a per-instance run state and a run lifecycle seam, and read/write
%% the reactive CockpitContext. Function-only modules are marked <<module>>;
%% type-only modules <<types>>; the rest are classes. Only the public (exported)
%% surface is shown.
classDiagram
    direction LR

    %% --- Composition root: folds the slices into one store and registers it.
    class CockpitView {
        <<module>>
        store('bsb/cockpit', mergeStoreParts(...slices))
        +__resetInstance() void
    }

    class StoreParts {
        <<module>>
        +mergeStoreParts(...StorePart) MergedStore
    }

    %% --- Store slices: each owns one surface of the deck and reads CockpitContext.
    class RunStore {
        <<module>>
        state: currentSrc (builds the ?bsbSurfIndex/&bsbNonce= URL from seeded config + activeIndex, then carries traits+speed+sterile onto it), run/idle/compact, isSterileRun (context.sterile && context.running), clock & rate readouts
        actions: toggleRun (refuses unsupported/charging; snapshots context.sterile from state.devtools?.surf?.sterile at start only), toggleCompact, guardViewport (stops the run on a failed iframe load/error)
        callbacks: syncRunActivity, initWakeLock, initPageAdvance (increments activeIndex on the surf engine's page-done message — no client-side wrap, the server wraps), syncViewportWatchdog (arms/clears the viewport load-hang watchdog), initExitGuard (native leave-confirmation while a run is live), syncDevtoolsSurf (mirrors state.devtools.surf.runLive = context.running; while live-and-sterile also mirrors surf.pageIndex = context.activeIndex and applies surf.pageStep to activeIndex, else clears surf.affordances/pageStep/pageIndex — only ever touches state.devtools when it exists)
    }

    class ConfigStore {
        <<module>>
        state: mode/speed flags, durationDisplay
        actions: selectMode, stepDuration, selectSpeed
        callbacks: rollDuration (odometer)
    }

    class TraitsStore {
        <<module>>
        state: archetypeLabel, pointsLeftDisplay, isBudgetEmpty, isCustomizeOpen, traitValue<i>, traitTrack<i>, isClass<Key>
        actions: selectClass, setTrait, resetTraits, toggleCustomize
    }

    class TargetStore {
        <<module>>
        state: targetDisplay, targetCap, targetColor
        actions: targetPointerDown/Move/Up, targetKeyDown
    }

    class BatteryStore {
        <<module>>
        state: batteryDisplay, batteryColor, isCharging, isBatteryUnsupported
        callbacks: initBattery (flags unsupported when API absent), syncBatteryOverride
        +applyReading(ctx, instance, BatteryReading) void
    }

    class BatteryOverride {
        <<module>>
        +resolveReading(BatteryReading|null, BatteryOverrideState) BatteryReading|null
    }

    class SoundStore {
        <<module>>
        state: isSoundOn
        actions: toggleSound
        callbacks: initSound
    }

    class SummaryStore {
        <<module>>
        state: ended/flipped/reason + verdict readouts
        actions: toggleFlip, newRun
        callbacks: renderSummary, initDetail (detail page: builds graph, auto-flips)
    }

    class StartupStore {
        <<module>>
        state: isIdleFlipped, isDeckShown (stays hidden when unsupported)
        actions: toggleIdleFlip
    }

    class ToastStore {
        <<module>>
        state: hasToast, isToastError/Notice, toastMessage, toastRole, phase flags
        actions: dismissToast, viewportEnter
        callbacks: onToastAnimationEnd
    }

    class BarkStore {
        <<module>>
        state: hasBark, barkKey, barkMessage, barkDurationCss, barkEbbName (alternates two identical keyframes per barkGeneration, guaranteeing the tide's drain restarts on every fresh bark), phase flags (isBarkEntering/Leaving)
        callbacks: initBark (raises a bark, held for its announced duration, from the surf engine's behaviorStart message, while running)
    }

    class SharkStore {
        <<module>>
        state: hasShark, sharkStartCss/sharkEndCss/sharkTotalCss (CSS projections of the planned swim), sharkBobCss (the bob's own √speed-scaled swing period)
        callbacks: initShark (document-level Konami listener, armed only while running && compact; each key must land within KONAMI_TIMEOUT_MS of the previous or the sequence restarts), syncSharkCompact (clears a live swim once the topbar stops showing it), syncDevtoolsShark (mirrors state.devtools.shark.launchable = running && compact and consumes the panel's stamped launch command exactly once, launching the swim from inside the block's own scope; clears a command pending outside the launch window — only ever touches state.devtools when it exists)
    }

    %% --- Shared seam between slices.
    class CockpitContext {
        <<types>>
        CockpitContext, RunEndReason, ReasonText, ToastKind, ToastPhase, BarkPhase
    }

    class Toasts {
        <<module>>
        +enqueueToast(ctx, instance, ToastKind) void
        +finishToast(ctx, instance) void
        +TOAST_HOLD_MS
    }

    class ToastQueue {
        +enqueue(ToastKind) void
        +next() ToastKind|null
        +size: number
        +clear() void
    }

    class RunInstance {
        <<module>>
        +instanceFor() InstanceState
        +now() number
        +wallNow() number
        +__resetInstance() void
    }

    class Barks {
        <<module>>
        +pickBarkText(strings, key, rng?) string
        +raiseBark(ctx, instance, key, durationMs) void
        +finishBark(ctx, instance) void
        +clearBark(ctx, instance) void
        +BARK_LEAVE_MS
    }

    class BehaviorStart {
        <<module>>
        +isBehaviorStartMessage(MessageEvent, string) boolean
        +behaviorKeyOf(MessageEvent) string
        +durationOf(MessageEvent) number
    }

    class Shark {
        <<module>>
        +planSwim(speed, rng?) SwimPlan
        +launchShark(ctx, instance, speed, rng?) void
        +clearShark(ctx, instance) void
        +SHARK_SURFACE_MS, SHARK_DIVE_MS, SHARK_FULL_CROSS_MS, SHARK_TRAIL_MAX_DELAY_MS
    }

    class KonamiCode {
        <<module>>
        +nextKonamiProgress(progress, key, elapsedMs) number
        +isKonamiComplete(progress) boolean
        +KONAMI_SEQUENCE, KONAMI_TIMEOUT_MS
    }

    %% Sterile-run iframe<->cockpit protocol seam (see surf-engine-modules.mmd
    %% for the engine-side sender/listener — SterileHelm). BehaviorEnd and
    %% PageAffordances are receivers (iframe -> cockpit); SteerBehavior is the
    %% one sender (cockpit -> iframe) in this whole feature.
    class BehaviorEnd {
        <<module>>
        +isBehaviorEndMessage(MessageEvent, string) boolean
        +behaviorEndKeyOf(MessageEvent) string
    }

    class PageAffordances {
        <<module>>
        +isPageAffordancesMessage(MessageEvent, string) boolean
        +affordancesOf(MessageEvent) PageAffordancesPayload
    }

    class SteerBehavior {
        <<module>>
        +postSteerBehavior(Window|null, string, string) void
    }

    class RunLifecycle {
        <<module>>
        +stopRun(ctx, instance, RunEndReason) void — skips SessionUpload entirely when ctx.sterile (a sterilized test run is not a benchmark)
        +applyReadouts(ctx, RunSession) void
        +GRAPH_VIEWPORT
    }

    class SessionUpload {
        <<module>>
        +statusFor(RunEndReason) string
        +modeFor(UploadConfig) string
        +buildSessionPayload(SessionUploadInput) SessionPayload|null
        +postSession(SessionPayload) Promise
    }

    class UserAgent {
        <<module>>
        +parseUserAgent(string) UserAgentInfo
    }

    class RunConfig {
        <<module>>
        +normalizeDuration(number) number
        +normalizeSpeed(number) Speed
        +normalizeMode(unknown) RunMode
        +DURATION_MIN, DURATION_MAX, DURATION_STEP
        +SPEEDS
    }

    %% Shared surfer-trait domain backing the Surfer profile UI.
    class SurferStats {
        <<module>>
        +classify(number[]) Archetype
        +clampTrait(number[], number, number) number
        +pointsLeft(number[]) number
        +headroom(number[], number) number
        +STATS, CLASSES, BUDGET, MIN, MAX
    }

    class TargetControl {
        <<module>>
        +targetCap(number|null) number
        +clampTarget(number, number) number
        +targetFromPointer(number, HTMLElement, number) number
        +targetColor(number) string
        +TARGET_MIN, TARGET_MAX, TARGET_STEP
    }

    %% The cockpit's half of the surf engine's transport seam (see
    %% surf-engine-modules.mmd for the engine-side receiver).
    class SurferUrl {
        <<module>>
        +withSurferParams(string, number[], number, sterile?) string — appends bsbSterile=1 only when sterile, omitted otherwise
    }

    %% Builds the opaque ?bsbSurfIndex=/&bsbNonce= base URL RunStore layers
    %% SurferUrl's traits+speed params onto. The client never holds a page
    %% list — CourseRouter (php-class-interactions.mmd) resolves an index
    %% server-side, wrapping it against the saved order's length.
    class SurfIndexUrl {
        <<module>>
        +buildSurfIndexUrl(string, number, string) string
        +SURF_INDEX_PARAM, SURF_NONCE_PARAM
    }

    class PageAdvance {
        <<module>>
        +isPageDoneMessage(MessageEvent, string) boolean
        +nextPageIndex(number) number
    }

    %% Pure decision behind the viewport load guard: the course router
    %% (see php-class-interactions.mmd's CourseRouter) stamps a `bsb-course-page`
    %% body class on every page it serves, so that class's absence on a `load`
    %% (or an outright `error`) means the framed page is not a real, loaded
    %% course page — a 404, a renamed/deleted catalog slug, or any other load
    %% failure that would otherwise leave the run ticking blind with no surf
    %% engine posting the page-done handshake. isBlankFrame filters out the
    %% viewport's own empty-src `about:blank` reset load (fired when a run
    %% starts/stops), which must never be judged as a failed navigation.
    class PageGuard {
        <<module>>
        +isBlankFrame(iframe) boolean
        +isCoursePageLoaded(iframe) boolean
        +viewportFailed(event, iframe) boolean
        +COURSE_PAGE_SELECTOR
    }

    %% Pure decision + browser incantation behind the navigate/reload guard:
    %% an active run (running === true) blocks leaving the cockpit, so a reload
    %% or navigation triggers the browser's native leave-confirmation dialog;
    %% idle or a finished-run summary never blocks. RunStore's initExitGuard
    %% callback wires a single beforeunload listener to these.
    class ExitGuard {
        <<module>>
        +runBlocksExit(context) boolean
        +confirmExit(event) void
    }

    %% Dark mode is disabled: the Theme module is retained in the codebase but
    %% intentionally unwired — no slice imports it, so the cockpit renders the
    %% light palette only and nothing reads/writes the stored pref.
    class Theme {
        <<module>>
        +resolveTheme(ThemePref) ThemeName
        +nextThemePref(ThemePref) ThemePref
        +readStoredPref() ThemePref
        +writeStoredPref(ThemePref) void
        +osPrefersDark() bool
    }

    class FinishChime {
        +__construct(make: () =&gt; AudioContextLike)
        +prime() void
        +play() void
        +readStoredSound()$ bool
        +writeStoredSound(bool)$ void
        +audioContextCtor()$ AudioContextCtor|null
        +SOUND_KEY
    }

    class Format {
        <<module>>
        +formatClock(number) string
        +formatTimeToEmpty(number|null) string
        +formatRate(number|null) string
        +durationDigits(number) number[]
    }

    class DrainRate {
        <<module>>
        +drainRate(Sample[]) DrainRateResult
        +windowDrainRate(Sample[], number) DrainRateResult
        +minutesToLevel(number, number, number|null) number|null
        +distinctLevelCount(Sample[]) number
        +WINDOW_MS
    }

    class DrainGraph {
        <<module>>
        +buildGraph(Sample[], number|null, GraphViewport) GraphModel|null
    }

    class GraphSvg {
        <<module>>
        +paintGraph(SVGElement, GraphModel|null) void
    }

    class SampleLog {
        +record(number, number, bool) void
        +all() RleSample[]
        +latest() RleSample|null
        +size: number
        +clear() void
    }

    class RunSession {
        +start(number) void
        +active: bool
        +record(number, number, bool) void
        +readouts() Readouts
        +summary() RunSummary|null
        +samples() RleSample[]
        +stop() void
    }

    class BatteryMonitor {
        +__construct(BatteryMonitorOptions)
        +start() void
        +stop() void
        +HEARTBEAT_MS
    }

    class ScreenWakeLock {
        +__construct(ScreenWakeLockOptions)
        +acquire() Promise
        +release() Promise
        +held: bool
    }

    %% Composition root wires the slices together.
    CockpitView --> StoreParts : merges slices
    CockpitView --> RunStore : composes
    CockpitView --> ConfigStore : composes
    CockpitView --> TraitsStore : composes
    CockpitView --> TargetStore : composes
    CockpitView --> BatteryStore : composes
    CockpitView --> SoundStore : composes
    CockpitView --> SummaryStore : composes
    CockpitView --> StartupStore : composes
    CockpitView --> ToastStore : composes
    CockpitView --> BarkStore : composes
    CockpitView --> SharkStore : composes

    %% Slices share the run state, lifecycle seam and reactive context.
    RunStore ..> CockpitContext : reads/writes
    ConfigStore ..> CockpitContext : reads/writes
    TraitsStore ..> CockpitContext : reads/writes
    TraitsStore --> SurferStats : point-buy & classify
    TargetStore ..> CockpitContext : reads/writes
    BatteryStore ..> CockpitContext : reads/writes
    SoundStore ..> CockpitContext : reads/writes
    SummaryStore ..> CockpitContext : reads/writes
    StartupStore ..> CockpitContext : reads/writes
    ToastStore ..> CockpitContext : reads/writes
    BarkStore ..> CockpitContext : reads/writes
    SharkStore ..> CockpitContext : reads/writes

    RunStore --> RunLifecycle : ends runs
    BatteryStore --> RunLifecycle : ends runs (charger/target)
    RunLifecycle --> RunInstance : reads run session
    RunStore --> RunInstance : run state
    BatteryStore --> RunInstance : run state
    SoundStore --> RunInstance : chime state
    SummaryStore --> RunInstance : auto-flip timer
    ToastStore --> RunInstance : toast queue & timer
    RunStore --> RunInstance : re-arms notice on run start
    BarkStore --> RunInstance : reads/writes the pending slot & timers
    SharkStore --> RunInstance : reads/writes Konami progress, its last-key timestamp & the clear timer

    %% Toast queue & lifecycle.
    ToastStore --> Toasts : enqueues / advances
    RunLifecycle --> Toasts : raises error toast on failed upload
    Toasts ..> CockpitContext : writes current toast
    RunInstance --> ToastQueue : creates & owns (composition)

    %% Bark lifecycle: a store-driven queue, duration-tied, no minimum
    %% on-screen time. BarkStore recognizes the engine's behaviorStart
    %% message (key + durationMs, only while running) and hands both to
    %% Barks, which owns the show / queue / leave-then-show state machine
    %% (depth-1 pending — only the newest arrival survives): a bark arriving
    %% while one is already showing (or leaving) queues rather than
    %% replacing it, and immediately begins the showing bark's leave — the
    %% outgoing bark always plays its full leave animation before the queued
    %% one enters. Two store-owned timers (held off-context in RunInstance)
    %% drive every transition — none of it animationend-driven: a duration
    %% timer for the announced dwell (entering -> leaving, cancelled early
    %% when a different key's arrival begins the leave itself instead), and a
    %% leave timer for the fixed leave duration (leaving -> cleared, pumping
    %% any pending bark fresh). The DOM's ebbing-tide fill is a pure reactive
    %% projection of barkDurationMs/barkPhase and never feeds back.
    BarkStore --> Barks : raises / finishes a bark
    BarkStore --> BehaviorStart : recognizes the message, reads the key & duration
    Barks ..> CockpitContext : writes the showing bark
    RunLifecycle --> Barks : clears the showing bark & its timers on stop

    %% Shark-fin Easter egg: store-authoritative, one swim at a time. SharkStore
    %% recognizes the Konami sequence at the document level (armed only while
    %% running && compact, keyed against KonamiCode — each key must land within
    %% KONAMI_TIMEOUT_MS of the previous or the sequence restarts) and hands a
    %% completed sequence to Shark, which plans a swim (random surfacing/diving
    %% points, a duration scaled by the run speed) and owns its single clear
    %% timer (held off-context in RunInstance, alongside the Konami progress and
    %% its last-key timestamp). The fin's CSS animations are a pure reactive
    %% projection of the plan and never feed back; being `hidden` between swims
    %% is itself the restart guarantee (un-hiding it restarts its animations
    %% fresh), so unlike the bark's ebbing tide no generation counter is needed.
    %% RunLifecycle clears a live swim on every cause of a run ending, and
    %% SharkStore's own watch clears one the instant the topbar stops showing it
    %% (the deck expands) even mid-run.
    %% The dev-tools panel's shark button releases a swim on demand through the same
    %% lifecycle: SharkStore.syncDevtoolsShark consumes the panel's stamped launch
    %% command and mirrors the launch window back for the button's disabled binding.
    SharkStore --> Shark : launches / clears the swim
    SharkStore --> KonamiCode : advances the sequence
    Shark ..> CockpitContext : writes the planned swim
    RunLifecycle --> Shark : clears the swim on stop

    %% Slice → focused domain delegation.
    RunStore --> RunConfig : normalizes config
    RunStore --> TargetControl : clamps target on start
    RunStore --> SurferUrl : carries traits+speed+sterile onto currentSrc
    RunStore --> SurfIndexUrl : builds the base ?bsbSurfIndex=/&bsbNonce= URL from seeded config
    RunStore --> PageAdvance : recognizes page-done, increments activeIndex
    RunStore --> PageGuard : decides load/error viewport failure
    RunStore --> ExitGuard : arms the beforeunload leave-confirmation
    RunStore --> Format : formats readouts
    RunStore --> ScreenWakeLock : creates & owns (composition)
    ConfigStore --> RunConfig : normalizes duration
    ConfigStore --> Format : duration digits
    TargetStore --> TargetControl : maps slider input
    BatteryStore --> TargetControl : caps idle target
    BatteryStore --> BatteryMonitor : creates & owns (composition)
    SoundStore --> FinishChime : creates & owns (composition)
    SummaryStore --> Format : formats verdict
    SummaryStore --> GraphSvg : paints chart from model
    SummaryStore --> DrainGraph : rebuilds detail chart from seeded samples
    SummaryStore --> RunLifecycle : reads GRAPH_VIEWPORT

    %% Ending a run persists it: the lifecycle builds the REST payload from the
    %% frozen session and POSTs it through the session post type's own endpoint,
    %% reading its REST access from the Interactivity config the PHP route seeds.
    RunLifecycle --> SessionUpload : persists finished run
    RunLifecycle --> UserAgent : parses capture browser fields
    SessionUpload ..> RunSession : reads RunSummary & samples

    %% Run lifecycle & instance own the long-lived calculation objects.
    RunInstance --> RunSession : creates & owns (composition)
    RunLifecycle --> DrainGraph : builds summary chart model
    BatteryMonitor ..> BatteryStore : reports BatteryReading

    GraphSvg ..> DrainGraph : draws GraphModel
    RunSession --> SampleLog : creates & owns (composition)
    RunSession --> DrainRate : fits & projects
    DrainGraph ..> DrainRate : maps Sample[]
    SampleLog ..> DrainRate : RleSample extends Sample

    %% Battery-override seam: every reading (real or dev-tools-forced) resolves
    %% through BatteryOverride before BatteryStore's exported applyReading acts
    %% on it, so display, sample recording and the stop conditions share one
    %% truth. Passthrough when no override is present or armed. The override
    %% BatteryStore feeds into BatteryOverride is itself the effective one —
    %% see EffectiveBatteryOverride below, which composes the dev-tools panel's
    %% manual layer with a running discharge sim.
    BatteryStore --> BatteryOverride : resolves reading before applying it
    BatteryStore --> EffectiveBatteryOverride : resolves the effective dev-tools override

    %% --- Dev-tools module (src/devtools/), enqueued only in a dev environment.
    %% A separate script module from CockpitView above; it joins the SAME
    %% `bsb/cockpit` namespace via the store-merge mechanism (later members
    %% override on collision), which is why every member it contributes carries
    %% a `devtools` prefix. In production this module never loads at all.
    %% The devtools slice is itself composed of a shared shell (persistence,
    %% panel open state) plus one StorePart per sub-tool: the manual battery
    %% override, the discharge simulation, and the Surf steerer — each own
    %% its own state field (`battery`, `sim`, `surf`) and never writes to the
    %% other's. A fourth tool is a new StorePart folded in here, not a rework
    %% of the composition root. Only `open` and `battery` persist across a
    %% reload — the discharge sim and the WHOLE Surf tool (its armed
    %% `sterile` flag included, so an arm from a prior session can never
    %% silently start a later run sterile) are live-session-only and never
    %% written to or restored from storage.
    class DevToolsView {
        <<module>>
        store('bsb/cockpit', mergeStoreParts(DevtoolsShellStore, BatteryOverrideStore, DischargeSimStore, SurfSteerStore, SharkReleaseStore, ResetStore))
    }

    class DevtoolsStore {
        <<module>>
        state: devtools.open, devtools.battery, devtools.sim, devtools.surf, devtools.shark
        actions: devtoolsToggleOpen
        callbacks: devtoolsPersist
        +current() DevtoolsState
        +hydrateDevtools() void
        +DEVTOOLS_STORAGE_KEY
    }

    class BatteryOverrideStore {
        <<module>>
        state: devtoolsIsChargingSystem/On/Off, devtoolsIsLevelForced, devtoolsLevelPercent, devtoolsLevelFillPercent, devtoolsIsArmed (also true while surf.sterile)
        actions: devtoolsSetCharging, devtoolsSetLevel, devtoolsResetLevel
        +resetBatteryOverride() void
    }

    class DischargeSimStore {
        <<module>>
        state: devtoolsSimFromDisplay/ToDisplay/MinutesDisplay, devtoolsIsSimRunning, devtoolsIsSimStartBlocked, devtoolsSimRemainingDisplay
        actions: devtoolsStepSim, devtoolsToggleSim
        +resetDischargeSim() void
    }

    %% The Surf sub-tool: arms/disarms the sterile override, steers each of
    %% the nine behaviors (strictly sequential — the chip gate mirrors the
    %% engine's own guard), and steps the course page. Owns the iframe<->
    %% cockpit bsb:behaviorStart/behaviorEnd/pageAffordances handshake and the
    %% 1s countdown ticker; the chip's --chip-dur custom property is fed the
    %% FIXED full announced duration (never the ticking remainingMs), so its
    %% tide fill animates smoothly instead of restarting every second.
    class SurfSteerStore {
        <<module>>
        state: devtoolsIsSurfNatural/Sterile, devtoolsSurfModeDisabled (locks the Natural/Sterile seg while any run — natural or sterile — is live), devtoolsSurfIsRunning, devtoolsSurfCountdownDisplay, devtoolsSurfPageSlug, devtoolsSurfChipDisabled/Gated/Running/DurationCss (parameterized per calling chip via getElement()'s data-devtools-behavior), devtoolsSurfStepDisabled
        actions: devtoolsSurfSetMode, devtoolsSurfSteer (posts bsb:steerBehavior to the viewport iframe), devtoolsSurfStep (writes a monotonic-seq pageStep command)
        callbacks: devtoolsInitSurf (the iframe message listener), devtoolsSyncSurfRun (clears the steered-behavior state once runLive flips false, rather than waiting on bsb:behaviorEnd)
        +resetSurfSteer() void
    }

    class SurfSteer {
        <<module>>
        +isChipDisabled(key, state) boolean
        +isChipGated(key, affordances) boolean
        +surfCountdownDisplay(key, remainingMs) string
        +pageSlugAt(slugs, pageIndex) string
        +SURF_BEHAVIOR_KEYS, CAUTION_KEY, DEFAULT_SURF
    }

    %% The shark-release sub-tool: the panel header's shark button. Writes a
    %% monotonic-seq launch command onto the shared slice — the panel has no
    %% cockpit context of its own, so it can never call the swim lifecycle
    %% directly — and reads back the launchability the cockpit's own
    %% SharkStore.syncDevtoolsShark mirrors onto it (a run live, the deck
    %% compact — the Konami egg's own arming window).
    class SharkReleaseStore {
        <<module>>
        state: devtoolsSharkDisabled (the launchability mirror, inverted)
        actions: devtoolsReleaseShark (writes a monotonic-seq launch command; no-op outside the launch window)
    }

    class SharkRelease {
        <<module>>
        +SharkLaunchCommand, SharkReleaseState, DEFAULT_SHARK_RELEASE
    }

    class EffectiveBatteryOverride {
        <<module>>
        +effectiveBatteryOverride(devtools) BatteryOverrideState
    }

    %% Composes the sub-tools' own exported resets rather than living in
    %% DevtoolsStore (the shared shell) — both sub-tools already import
    %% `current` from that shell, so a shell-owned reset would need to import
    %% each sub-tool's reset back, forming a sub-tool <-> shell import cycle.
    %% Sitting to the side instead, only this module imports from both
    %% sub-tools, so no cycle forms.
    class ResetStore {
        <<module>>
        actions: devtoolsReset
    }

    class DischargeSim {
        <<module>>
        +simDurationMs(DischargeSimConfig) number
        +simProgress(DischargeSimConfig, number) number
        +simulatedLevel(DischargeSimConfig, number) number
        +isSimComplete(DischargeSimConfig, number) bool
        +simRemainingMs(DischargeSimConfig, number) number
        +DEFAULT_SIM
    }

    DevToolsView --> StoreParts : merges slices
    DevToolsView --> DevtoolsStore : composes (shared shell)
    DevToolsView --> BatteryOverrideStore : composes
    DevToolsView --> DischargeSimStore : composes
    DevToolsView --> SurfSteerStore : composes
    DevToolsView --> SharkReleaseStore : composes
    DevToolsView --> ResetStore : composes
    BatteryOverrideStore --> DevtoolsStore : reads/writes the shared devtools slice
    DischargeSimStore --> DevtoolsStore : reads/writes the shared devtools slice
    DischargeSimStore --> DischargeSim : evaluates the pure model against the clock
    SurfSteerStore --> DevtoolsStore : reads/writes the shared devtools slice
    SurfSteerStore --> SurfSteer : gating/formatting rules
    %% Mermaid rejects a second colon in a relation label, so the bsb message
    %% names below write theirs as the #58; entity (it renders as a colon).
    SurfSteerStore --> BehaviorStart : recognizes bsb#58;behaviorStart to start the running countdown
    SurfSteerStore --> BehaviorEnd : recognizes bsb#58;behaviorEnd to clear the running key
    SurfSteerStore --> PageAffordances : recognizes bsb#58;pageAffordances to store the live page's flags
    SurfSteerStore --> SteerBehavior : posts bsb#58;steerBehavior to the viewport iframe's contentWindow
    SharkReleaseStore --> DevtoolsStore : reads/writes the shared devtools slice
    SharkReleaseStore --> SharkRelease : the pure model behind its state

    %% The discharge sim writes only its own `sim.currentLevel`/`remainingMs`/
    %% `running` fields — never `devtools.battery`, which BatteryOverrideStore's manual
    %% actions alone own. The two layers are combined into the single
    %% effective override by the pure EffectiveBatteryOverride resolver: a
    %% running sim always wins outright; otherwise the manual layer passes
    %% through unchanged. BatteryOverrideStore's own getters (armed/level/
    %% charging) route through the same resolver so the panel reflects a
    %% running sim, while its actions still only ever touch `battery`.
    BatteryOverrideStore --> EffectiveBatteryOverride : resolves the effective override for its getters

    %% The panel-wide Reset button composes each sub-tool's own exported
    %% reset — it never duplicates their logic, and it is the only module that
    %% depends on all three sub-tools at once.
    ResetStore --> BatteryOverrideStore : calls resetBatteryOverride()
    ResetStore --> DischargeSimStore : calls resetDischargeSim()
    ResetStore --> SurfSteerStore : calls resetSurfSteer()

    DevtoolsStore ..> BatteryStore : joins bsb/cockpit store (state.devtools.battery)
    BatteryStore ..> DevtoolsStore : reads state.devtools.battery (undefined in production)
    DevtoolsStore ..> RunStore : joins bsb/cockpit store (state.devtools.surf)
    RunStore ..> DevtoolsStore : reads/writes state.devtools.surf (undefined in production)
    DevtoolsStore ..> SharkStore : joins bsb/cockpit store (state.devtools.shark)
    SharkStore ..> DevtoolsStore : reads/writes state.devtools.shark (undefined in production)
