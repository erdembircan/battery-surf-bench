# Files and folders left out of every plugin build. The `archive:plugin`
# step of `composer build:development` and `composer build:production` packs
# everything not listed here, including the untracked build/ assets and the
# production vendor/ tree, and the build assembles the plugin from that
# archive.
#
# composer.json ships on purpose: WordPress.org asks plugins that bundle
# Composer dependencies to include it alongside vendor/.
#
# The dev-tools panel isn't listed: the development build ships it, and the
# production build leaves it out on its own (webpack.config.js,
# bin/Assemble.mts).
#
# `pnpm run package:verify` checks each zip against the allowed contents in
# bin/PackageRules.mts at the end of `composer zip:development` and
# `composer zip:production`, and CI runs `composer zip:production` on every
# pull request and merge, so a stray top-level path or a hidden file or folder
# that these rules miss fails the build instead of reaching WordPress.org.
/.git                  export-ignore
/.github               export-ignore
/.wordpress-org        export-ignore
/.claude               export-ignore
/.pnpm-store           export-ignore
/bin                   export-ignore
/node_modules          export-ignore
/src                   export-ignore
/tests                 export-ignore
/docs                  export-ignore
/wp-playground         export-ignore
/playwright            export-ignore
/coverage              export-ignore
/.phpunit.cache        export-ignore
/test-results          export-ignore
/playwright-report     export-ignore
/zip                   export-ignore
/dist                  export-ignore
/.gitignore            export-ignore
/.gitattributes        export-ignore
/.editorconfig         export-ignore
/.prettierignore       export-ignore
/.licensewizardrc.json export-ignore
/CLAUDE.md             export-ignore
/README.md             export-ignore
/composer.lock         export-ignore
/package.json          export-ignore
/pnpm-lock.yaml        export-ignore
/pnpm-workspace.yaml   export-ignore
/eslint.config.cjs     export-ignore
/webpack.config.js     export-ignore
/tsconfig.json         export-ignore
/phpcs.xml.dist        export-ignore
/phpunit.xml.dist      export-ignore
/patchwork.json        export-ignore
/vitest.config.mts     export-ignore
/vitest.setup.ts       export-ignore
/playwright.config.mts export-ignore
/playwright.screenshots.config.mts export-ignore
*.map                  export-ignore
# macOS Finder metadata is never tracked, but composer archive also packs
# untracked files, so match it at any depth.
.DS_Store              export-ignore

# Files a live site never loads. bin/PackageRules.mts fails the build when a
# translation file or assets/ ships.
#
# The stylesheets inline these images at build time.
/assets                   export-ignore
# Bundled libraries' own repository files and readmes.
/vendor/**/.*             export-ignore
/vendor/**/README.md      export-ignore
