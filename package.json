{
  "name": "battery-surf-bench",
  "version": "1.0.0",
  "description": "WordPress plugin that benchmarks battery drain while simulating browsing.",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "WP_EXPERIMENTAL_MODULES=true wp-scripts build",
    "start": "WP_EXPERIMENTAL_MODULES=true wp-scripts start",
    "typecheck": "tsc --noEmit",
    "lint:js": "wp-scripts lint-js",
    "license:verify": "license-wizard --verify --strict",
    "package:verify": "tsx bin/VerifyPackage.mts zip/battery-surf-bench.zip",
    "contracts:verify": "tsx bin/VerifyContracts.mts",
    "format": "wp-scripts format \"**/*.{js,cjs,mjs,ts,tsx,mts,cts}\"",
    "i18n:make-pot": "wp i18n make-pot . languages/battery-surf-bench.pot --domain=battery-surf-bench --exclude=build,wp-playground,tests,playwright-report,test-results,.claude",
    "i18n:make-php": "wp i18n make-php languages",
    "i18n:make-json": "wp i18n make-json languages --no-purge --pretty-print",
    "i18n": "pnpm run i18n:make-pot && pnpm run i18n:make-php && pnpm run i18n:make-json",
    "test": "vitest run",
    "test:watch": "vitest",
    "playground": "tsx wp-playground/start.mts",
    "playground:fresh": "tsx wp-playground/start.mts --reset",
    "playground:test": "tsx wp-playground/start-test.mts",
    "playground:test:unauth": "tsx wp-playground/start-unauth-test.mts",
    "dev:sync": "tsx wp-playground/live-reload.mts",
    "dev": "concurrently --kill-others --names \"build,wp,sync\" -c \"blue,magenta,green\" \"pnpm:start\" \"pnpm:playground\" \"pnpm:dev:sync\"",
    "test:e2e": "playwright test --config playwright.config.mts",
    "pretest:e2e": "pnpm run build",
    "test:e2e:unauth": "E2E_TARGET=unauth playwright test --config playwright.config.mts",
    "pretest:e2e:unauth": "pnpm run build",
    "test:e2e:all": "pnpm run test:e2e && pnpm run test:e2e:unauth",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@fontsource/anton": "^5.2.7",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@fontsource/pacifico": "^5.2.7",
    "@fontsource/space-mono": "^5.2.9",
    "@playwright/test": "^1.61.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^21.1.7",
    "@types/livereload": "^0.9.5",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@wordpress/api-fetch": "^7.48.0",
    "@wordpress/components": "^35.0.0",
    "@wordpress/core-data": "^7.48.0",
    "@wordpress/data": "^10.48.0",
    "@wordpress/element": "^8.0.0",
    "@wordpress/i18n": "^6.21.0",
    "@wordpress/interactivity": "^6.48.1",
    "@wordpress/scripts": "^32.4.0",
    "@wp-playground/blueprints": "^3.1.39",
    "@wp-playground/cli": "^3.1.39",
    "concurrently": "^10.0.3",
    "eslint-plugin-dotignore": "^1.0.0",
    "jsdom": "^25.0.1",
    "license-wizard": "^1.0.2",
    "livereload": "^0.10.3",
    "mermaid": "^11.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.101.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "license": "GPL-2.0-or-later",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@wordpress/dataviews": "^4.22.0"
  }
}
