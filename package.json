{
  "name": "battery-surf-bench",
  "version": "1.0.0-dev",
  "description": "WordPress plugin that benchmarks battery drain while simulating browsing.",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "typecheck": "tsc --noEmit",
    "lint:js": "wp-scripts lint-js",
    "playground": "tsx wp-playground/start.mts",
    "playground:fresh": "tsx wp-playground/start.mts --reset",
    "playground:test": "tsx wp-playground/start-test.mts",
    "dev:sync": "tsx wp-playground/live-reload.mts",
    "dev": "concurrently --kill-others --names \"build,wp,sync\" -c \"blue,magenta,green\" \"pnpm:start\" \"pnpm:playground\" \"pnpm:dev:sync\"",
    "test:e2e": "playwright test --config playwright.config.mts",
    "pretest:e2e": "pnpm run build",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/livereload": "^0.9.5",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wordpress/components": "^35.0.0",
    "@wordpress/core-data": "^7.48.0",
    "@wordpress/data": "^10.48.0",
    "@wordpress/element": "^8.0.0",
    "@wordpress/i18n": "^6.21.0",
    "@wordpress/scripts": "^32.4.0",
    "@wp-playground/blueprints": "^3.1.39",
    "@wp-playground/cli": "^3.1.39",
    "concurrently": "^10.0.3",
    "livereload": "^0.10.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@wordpress/dataviews": "^4.22.0"
  }
}
